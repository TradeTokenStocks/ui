# Public web client identifiers from Privy Dashboard > App settings > Clients.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
NEXT_PUBLIC_PRIVY_CLIENT_ID=your-privy-web-client-id

# Server-only Envio HyperIndex GraphQL endpoint used by /api/envio/multiplier-events.
ENVIO_GRAPHQL_URL=https://indexer.dev.hyperindex.xyz/b5fe9eb/v1/graphql

# Server-only authentication and SnapTrade configuration. Never prefix these with NEXT_PUBLIC_.
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Which kind of SnapTrade key this deployment holds. Defaults to "commercial".
#
#   commercial — a SnapTrade user is registered per signed-in person, and each
#                sees only the brokerage they linked. Required for anything more
#                than one person can reach. A commercial *test* key is enough:
#                the simulated brokerage sandbox is enabled on non-production
#                keys at no cost.
#   personal   — the key IS a single SnapTrade user. Everyone who signs in reads
#                the key owner's brokerage, and anyone who walks the connection
#                portal links their brokerage INTO that same account. Local
#                demos only. Never deploy this mode anywhere others can reach.
SNAPTRADE_KEY_MODE=commercial
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key
# Seals each person's SnapTrade user secret. Commercial mode only.
# Generate with: openssl rand -base64 32
SNAPTRADE_CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

WEB_APP_URL=http://localhost:3000
MOBILE_APP_REDIRECT_URL=tradetokenstocks://connections?connected=1
