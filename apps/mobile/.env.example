# Public mobile client identifiers from Privy Dashboard > App settings > Clients.
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-privy-mobile-client-id
# HTTPS origin of the deployed Next.js app. The same backend serves web and mobile.
EXPO_PUBLIC_API_URL=https://your-web-app.example
