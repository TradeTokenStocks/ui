{
  "name": "tradetokenstocks",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "turbo dev --filter=@tradetoken/mobile",
    "dev:web": "turbo dev --filter=@tradetoken/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "unrs-resolver"
  ]
}
